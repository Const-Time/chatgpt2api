# 每个值分别运行 openssl rand -hex 24 生成，不要复用。
POSTGRES_ADMIN_PASSWORD=
CHATGPT2API_DATABASE_PASSWORD=
CHATGPT2API_AUTH_KEY=

CPR_IMAGE=ghcr.io/const-time/codex-proxy-rs:latest
CHATGPT2API_IMAGE=ghcr.io/const-time/chatgpt2api:latest

# 默认供宿主机反向代理访问；如需局域网访问，设为宿主机的局域网 IP。
BIND_ADDRESS=127.0.0.1
CPR_PORT=8080
CHATGPT2API_PORT=3000
CHATGPT2API_BASE_URL=
CHATGPT2API_THREAD_TOKENS=120
